@page "/seguros/informes/{moduloId}/{submoduloId}/dashboardContinuidades/{opcionId}"
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard Continuidades SGMM";
    ViewData["Titulo"] = "Dashboard Continuidades SGMM";
}
<section class="content">
    <div class="container-fluid">

        <!-- ENCABEZADO EXCLUSIVO DEL PDF -->
        <div class="pdf-header" id="pdfHeader">
            <div class="pdf-institucion">ÓRGANO DE ADMINISTRACIÓN JUDICIAL</div>
            <div class="pdf-direccion">DIRECCIÓN GENERAL DE SERVICIOS AL PERSONAL</div>
            <h2>Dashboard de Continuidades del Seguro de Gastos Médicos Mayores</h2>
            <div class="pdf-subtitle" id="pdfPeriodo"></div>
        </div>

        <!-- FILTROS -->
        <div class="card card-outline card-primary no-print">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-filter mr-1"></i> Filtros</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <div class="form-group">
                            <label>Año</label>
                            <select id="filtroAnio" class="form-control">
                                @for (var anio = Model.AnioActual - 4; anio <= Model.AnioActual + 1; anio++)
                                {
                                    if (anio == Model.AnioActual)
                                    {
                                        <option value="@anio" selected>@anio</option>
                                    }
                                    else
                                    {
                                        <option value="@anio">@anio</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Mes</label>
                            <select id="filtroMes" class="form-control">
                                @{
                                    var meses = System.Globalization.CultureInfo.GetCultureInfo("es-MX").DateTimeFormat.MonthNames;
                                }
                                @for (var mes = 1; mes <= 12; mes++)
                                {
                                    if (mes == Model.MesActual)
                                    {
                                        <option value="@mes" selected>@meses[mes - 1]</option>
                                    }
                                    else
                                    {
                                        <option value="@mes">@meses[mes - 1]</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Tipo de personal</label>
                            <select id="filtroTipo" class="form-control">
                                <option value="">Todos</option>
                                <option value="OP">Operativo</option>
                                <option value="MM">Mando Medio</option>
                                <option value="MS">Mando Superior</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <div class="form-group w-100">
                            <button id="btnConsultar" type="button" class="btn btn-primary btn-block">
                                <i class="fas fa-search"></i> Consultar
                            </button>
                        </div>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <div class="form-group w-100">
                            <button id="btnExportarPdf" type="button" class="btn btn-danger btn-block" title="Generar PDF institucional mediante RDLC">
                                <i class="fas fa-file-pdf"></i> Exportar PDF
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FORMULARIO OCULTO PARA EXPORTACIÓN RDLC -->
        <form id="formExportarRdlc" method="post" asp-page-handler="ExportarPdf" target="_blank" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" id="rdlcDashboardJson" name="dashboardJson" />
            <input type="hidden" id="rdlcPeriodo" name="periodo" />
            <input type="hidden" id="rdlcTipoPersonal" name="tipoPersonal" />
            <input type="hidden" id="rdlcGraficaEstatus" name="graficaEstatusBase64" />
        </form>

        <div class="row">
            <div class="col-lg col-md-4 col-6"
                 data-total-id="total">
                <div class="small-box">
                    <div class="inner">
                        <h4 id="totalContinuidades"></h4>
                        <p>Total</p>
                    </div>

                    <div class="icon">
                        <i class="fa-solid fa-sigma"></i>
                    </div>
                </div>
            </div>
            @foreach (var item in Model.Estatus)
            {
                var id = "total" + item.Abreviacion;

                <div class="col-lg col-md-4 col-6 dashboard-estatus"
                     data-total-id="@id">
                    <div class="small-box @Html.Raw(item.Fondo)">
                        <div class="inner">
                            <h4 id="@id"></h4>
                            <p>@Html.Raw(item.Icono) @item.Nombre</p>
                        </div>

                        <div class="icon">
                            @Html.Raw(item.Icono)
                        </div>
                    </div>
                </div>
            }
        </div>


        <!-- TABLA -->
        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Detalle semanal</h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover table-bordered text-nowrap mb-0 tabla-dashboard">
                    <thead id="tablaSemanasHead"></thead>
                    <tbody id="tablaSemanas"></tbody>
                    <tfoot id="tablaSemanasFoot"></tfoot>
                </table>
            </div>
        </div>

        <!-- COMPORTAMIENTO SEMANAL -->
        <div class="card card-outline card-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="dashboard-section-title">Comportamiento semanal del mes</h5>
                        <div class="dashboard-section-subtitle" id="periodoSemanal"></div>
                    </div>
                    <span id="periodoTitulo" class="badge badge-primary"></span>
                </div>
                <div class="row" id="contenedorSemanas"></div>
            </div>
        </div>

        <!-- RESUMEN MENSUAL + GRÁFICA CIRCULAR -->
        <div class="row">
            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="dashboard-section-title">Resumen mensual por estatus</h5>
                        <div class="dashboard-section-subtitle mb-4">Comparativo general del periodo</div>
                        <div id="resumenMensualEstatus"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="dashboard-section-title">Distribución por estatus</h5>
                        <div class="dashboard-section-subtitle mb-3">Porcentaje respecto del total</div>
                        <div class="chart-container-dashboard">
                            <canvas id="chartEstatus"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="pdf-header" style="border-bottom:0; border-top:1px solid #adb5bd; margin-top:8px; padding-top:5px; padding-bottom:0;">
            <div class="pdf-subtitle">Dirección General de Servicios al Personal · Información para fines institucionales</div>
        </div>
    </div>
</section>

<style>
    .dashboard-resumen-card {
        border-radius: 12px;
        border: 1px solid #dee2e6;
        padding: 15px;
        height: 100%;
        box-shadow: 0 2px 6px rgba(0,0,0,.05);
    }

        .dashboard-resumen-card .titulo {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .dashboard-resumen-card .valor {
            font-size: 25px;
            font-weight: 700;
            line-height: 1;
        }

        .dashboard-resumen-card .porcentaje {
            font-size: 12px;
            color: #fff;
            margin-top: 7px;
        }

    .dashboard-section-title {
        font-weight: 700;
        font-size: 17px;
        margin-bottom: 0;
    }

    .dashboard-section-subtitle {
        font-size: 12px;
        color: #6c757d;
    }

    .semana-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        background: #fff;
        padding: 15px;
        margin-bottom: 15px;
        box-shadow: 0 1px 4px rgba(0,0,0,.04);
        height: calc(100% - 15px);
    }

    .semana-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 15px;
    }

    .semana-titulo {
        font-weight: 700;
        font-size: 14px;
    }

    .semana-periodo {
        font-size: 12px;
        color: #6c757d;
    }

    .semana-total {
        font-weight: 700;
        background: #f1f3f5;
        border-radius: 14px;
        padding: 3px 9px;
        font-size: 12px;
    }

    .personal-row {
        margin-bottom: 11px;
    }

        .personal-row:last-child {
            margin-bottom: 0;
        }

    .personal-info {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        margin-bottom: 4px;
    }

    .progress-dashboard {
        height: 8px;
        border-radius: 20px;
        overflow: hidden;
        background-color: #edf0f2;
    }

        .progress-dashboard .progress-bar {
            border-radius: 20px;
        }

    /* Relleno propio del dashboard. No utiliza .progress-bar de Bootstrap/AdminLTE,
                           para evitar que el tema institucional sobrescriba el color. */
    .dashboard-fill {
        display: block;
        height: 100%;
        min-width: 2px;
        border-radius: 20px;
        transition: width .25s ease;
    }

    /* Colores aplicados únicamente al comportamiento semanal y mensual.
                           Se usa !important para evitar que AdminLTE/Bootstrap sobrescriban el fondo. */
    #contenedorSemanas .barra-op {
        background: #007bff !important;
    }

    #contenedorSemanas .barra-mm {
        background: #28a745 !important;
    }

    #contenedorSemanas .barra-ms {
        background: #17a2b8 !important;
    }

    #resumenMensualEstatus .barra-ing {
        background: #007bff !important;
    }

    #resumenMensualEstatus .barra-pag {
        background: #28a745 !important;
    }

    #resumenMensualEstatus .barra-can {
        background: #dc3545 !important;
    }

    #resumenMensualEstatus .barra-imp {
        background: #ffc107 !important;
    }

    #resumenMensualEstatus .barra-cor {
        background: #17a2b8 !important;
    }

    #resumenMensualEstatus .barra-estatus-default {
        background: #6c757d !important;
    }

    .estatus-resumen {
        margin-bottom: 18px;
    }

    .estatus-resumen-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
        font-size: 13px;
    }

    .estatus-resumen-total {
        font-weight: 700;
    }

    .estatus-desglose {
        margin-top: 5px;
        font-size: 11px;
        color: #6c757d;
    }

    .chart-container-dashboard {
        position: relative;
        min-height: 340px;
        height: 340px;
    }

    .tabla-dashboard thead th,
    .tabla-dashboard tfoot th {
        text-align: center;
        vertical-align: middle;
        font-size: 12px;
        white-space: nowrap;
    }

    .tabla-dashboard tbody td {
        vertical-align: middle;
        font-size: 12px;
    }

        .tabla-dashboard tbody td:not(:first-child) {
            text-align: center;
        }

    /* Encabezado exclusivo para la exportación/impresión en PDF. */
    .pdf-header {
        display: none;
    }

    /* Mantiene los colores reales del dashboard al imprimir o guardar como PDF. */
    .dashboard-fill,
    .badge,
    .dashboard-resumen-card,
    canvas {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

    @@media print {
        @@page {
            size: A4 portrait;
            margin: 10mm;
        }

        html,
        body {
            background: #fff !important;
            width: 100% !important;
            height: auto !important;
            overflow: visible !important;
            font-size: 18px !important;
            background: #ffffff !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        /* Elementos de AdminLTE que no deben formar parte del PDF. */
        .main-header,
        .main-sidebar,
        .main-footer,
        .control-sidebar,
        .content-header,
        .no-print {
            display: none !important;
        }

        .content-wrapper,
        .content,
        .container-fluid {
            margin: 0 !important;
            padding: 0 !important;
            min-height: 0 !important;
            width: 100% !important;
            background: #fff !important;
        }

        .pdf-header {
            display: block !important;
            width: 100% !important;
            margin-bottom: 16px !important;
            padding-bottom: 10px !important;
            border-bottom: 2px solid #343a40 !important;
            text-align: center !important;
        }

            .pdf-header .pdf-institucion {
                margin: 0;
                font-size: 18px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .25px;
                text-align: center;
            }

            .pdf-header .pdf-direccion {
                margin-top: 2px;
                font-size: 14px;
                font-weight: 600;
                text-transform: uppercase;
                text-align: center;
            }

            .pdf-header h2 {
                margin: 7px 0 0 0;
                font-size: 25px;
                font-weight: 700;
                text-align: center;
            }

            .pdf-header .pdf-subtitle {
                margin-top: 4px;
                font-size: 14px;
                color: #495057 !important;
                text-align: center;
            }

        .card,
        .dashboard-resumen-card,
        .semana-card {
            box-shadow: none !important;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        #contenedorResumen {
            margin-bottom: 2px !important;
        }

            #contenedorResumen > div {
                flex: 0 0 25% !important;
                max-width: 25% !important;
                padding-left: 4px !important;
                padding-right: 4px !important;
                margin-bottom: 6px !important;
            }

        .dashboard-resumen-card {
            padding: 11px !important;
            border-radius: 6px !important;
        }

            .dashboard-resumen-card .titulo {
                font-size: 12px !important;
            }

            .dashboard-resumen-card .valor {
                font-size: 24px !important;
            }

            .dashboard-resumen-card .porcentaje {
                font-size: 11px !important;
                margin-top: 4px !important;
            }

        .dashboard-section-title {
            font-size: 17px !important;
        }

        .dashboard-section-subtitle,
        .semana-periodo,
        .estatus-desglose {
            font-size: 11px !important;
        }

        .semana-card {
            padding: 12px !important;
            margin-bottom: 9px !important;
        }

        .semana-header {
            margin-bottom: 10px !important;
        }

        .semana-titulo {
            font-size: 14px !important;
        }

        .semana-total {
            font-size: 13px !important;
            padding: 4px 9px !important;
        }

        .personal-row {
            margin-bottom: 8px !important;
        }

        .personal-info,
        .estatus-resumen-header {
            font-size: 12px !important;
        }

        .progress-dashboard {
            height: 7px !important;
        }

        .chart-container-dashboard {
            min-height: 250px !important;
            height: 250px !important;
        }

        .tabla-dashboard {
            font-size: 11px !important;
        }

            .tabla-dashboard thead th,
            .tabla-dashboard tbody td,
            .tabla-dashboard tfoot th {
                font-size: 11px !important;
                padding: 6px !important;
            }
        /* Fuerza la conservación de fondos y colores en Chrome/Edge. */
        *,
        *::before,
        *::after {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }

    @@media (max-width: 767px) {
        .dashboard-resumen-card {
            margin-bottom: 10px;
        }

        .chart-container-dashboard {
            min-height: 280px;
            height: 280px;
        }
    }
</style>

@section Scripts {

    <!-- Si Chart.js ya está cargado en _Layout, elimina esta referencia. -->
    <script src="~/plugins/chart.js/Chart.min.js"></script>

    <script>
        let chartSemanas = null;
        let chartEstatus = null;
        let chartComparativo = null;
        let ultimoDashboardData = null;

        /*
         * Plugin compatible con Chart.js 2.x.
         * Muestra porcentajes sobre barras y dentro de la gráfica de dona.
         */
        Chart.plugins.register({
            afterDatasetsDraw: function (chart) {
                const config = chart.options.porcentajeLabels;
                
                if (!config || !config.enabled)
                    return;

                const ctx = chart.ctx;

                ctx.save();
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.font = 'bold 11px Arial';

                // BARRAS
                if (chart.config.type === 'bar') {

                    chart.data.datasets.forEach(function (dataset, datasetIndex) {

                        const meta = chart.getDatasetMeta(datasetIndex);

                        if (meta.hidden)
                            return;

                        meta.data.forEach(function (barra, index) {

                            const valor = Number(dataset.data[index]) || 0;

                            if (valor <= 0)
                                return;

                            const porcentaje =
                                dataset.porcentajes &&
                                dataset.porcentajes[index] != null
                                    ? dataset.porcentajes[index]
                                    : 0;

                            if (porcentaje <= 0)
                                return;

                            const posicion = barra.tooltipPosition();

                            ctx.fillStyle = '#343a40';

                            const etiquetaBarra =
                                `${valor.toLocaleString('es-MX')} ${valor === 1 ? 'continuidad' : 'continuidades'} (${porcentaje.toFixed(1)}%)`;

                            ctx.fillText(
                                etiquetaBarra,
                                posicion.x,
                                posicion.y - 10
                            );
                        });
                    });
                }

                // DONA
                if (chart.config.type === 'doughnut') {

                    const dataset = chart.data.datasets[0];

                    if (!dataset)
                        return;

                    const valores =
                        dataset.data.map(v => Number(v) || 0);

                    const total =
                        valores.reduce(
                            (acumulado, valor) => acumulado + valor,
                            0
                        );

                    if (total <= 0)
                        return;

                    const meta = chart.getDatasetMeta(0);

                    meta.data.forEach(function (segmento, index) {

                        const valor = valores[index];

                        if (valor <= 0)
                            return;

                        const porcentaje = (valor / total) * 100;

                        // Evita que los porcentajes de segmentos pequeños se amontonen.
                        // Todos los valores siguen disponibles en la leyenda y en el tooltip.
                        const minimoVisible = valores.length > 5 ? 7 : 4;
                        if (porcentaje < minimoVisible)
                            return;

                        const modelo = segmento._model;

                        if (!modelo)
                            return;

                        const angulo =
                            (modelo.startAngle + modelo.endAngle) / 2;

                        const radio =
                            (modelo.innerRadius + modelo.outerRadius) / 2;

                        const x =
                            modelo.x + Math.cos(angulo) * radio;

                        const y =
                            modelo.y + Math.sin(angulo) * radio;

                        ctx.fillStyle = '#ffffff';
                        ctx.font = 'bold 9px Arial';

                        ctx.fillText(
                            `${porcentaje.toFixed(1)}%`,
                            x,
                            y
                        );
                    });
                }

                ctx.restore();
            }
        });

        
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('btnConsultar').addEventListener('click', cargarDashboard);
            document.getElementById('btnExportarPdf').addEventListener('click', exportarPdf);
            cargarDashboard();
        });
        
        
        function exportarPdf() {
            if (!ultimoDashboardData) {
                if (window.toastr) {
                    toastr.warning('Primero consulta la información del dashboard.','Dashboard SGMM');
                } else {
                    alert('Primero consulta la información del dashboard.');
                }
                return;
            }
            
            const boton = document.getElementById('btnExportarPdf');
            const mesSelect = document.getElementById('filtroMes');
            const anio = document.getElementById('filtroAnio').value;
            const mes = mesSelect.options[mesSelect.selectedIndex]?.text || '';
            const tipoSelect = document.getElementById('filtroTipo');
            const tipo = tipoSelect.options[tipoSelect.selectedIndex]?.text || 'Todos';
            const formulario = document.getElementById('formExportarRdlc');
            const textoOriginal = boton.innerHTML;
            try {
                boton.disabled = true;
                boton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generando PDF...';

                if (chartEstatus) {
                    chartEstatus.stop();
                    chartEstatus.update(0);
                }
                
                document.getElementById('rdlcDashboardJson').value = JSON.stringify(ultimoDashboardData);
                document.getElementById('rdlcPeriodo').value = ultimoDashboardData.periodo || `${mes} ${anio}`;
                document.getElementById('rdlcTipoPersonal').value = tipo;
                document.getElementById('rdlcGraficaEstatus').value = chartEstatus ? chartEstatus.toBase64Image() : '';

                /*
                 * Garantizamos que el resultado del POST
                 * se abra en otra pestaña.
                 */
                formulario.target = '_blank';
                formulario.submit();
            } catch (error) {
                console.error('Error al generar PDF:',error);
                if (window.toastr) {

                    toastr.error('No fue posible generar el reporte.','Dashboard SGMM');
                }
                else {
                    alert('No fue posible generar el reporte.');
                }
            }
            finally {

                window.setTimeout(
                    function () {
                        boton.disabled = false;
                        boton.innerHTML = textoOriginal;
                    }, 700
                );
            }
        }
        
        async function cargarDashboard() {
            const anio = document.getElementById('filtroAnio').value;
            const mes = document.getElementById('filtroMes').value;
            const tipo = document.getElementById('filtroTipo').value;
            const boton = document.getElementById('btnConsultar');

            try {

                boton.disabled = true;
                boton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Consultando...';

                const parametros = new URLSearchParams({
                    handler: 'Datos',
                    anio: anio,
                    mes: mes
                });
                
                if (tipo)
                    parametros.append('tipoPersonal', tipo);

                const response = await fetch(
                    `${window.location.pathname}?${parametros.toString()}`,
                    {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    }
                );
                
                if (!response.ok) {

                    let mensaje = 'No fue posible obtener la información.';
                    try {
                        const error = await response.json();

                        mensaje = error.detalle || error.mensaje || mensaje;

                        console.error('Error Dashboard:',error);
                    }
                    catch {
                        // Se conserva el mensaje genérico.
                    }
                    throw new Error(mensaje);
                }

                const data = await response.json();
                actualizarDashboard(data);
            }
            catch (error) {

                console.error(error);

                if (window.toastr) 
                {
                    toastr.error(error.message,'Dashboard SGMM');
                }
                else 
                {
                    alert(error.message);
                }
            }
            finally {
                boton.disabled = false;
                boton.innerHTML = '<i class="fas fa-search"></i> Consultar';
            }
        }

        function actualizarDashboard(data) {

            ultimoDashboardData = data;

            document.getElementById('periodoTitulo').textContent = data.periodo || '';
            document.getElementById('periodoSemanal').textContent = data.periodo || '';

            actualizarEstatus(data.estatus || []);
            actualizarPorcentajesCards(data.estatus || []);
            construirTarjetasSemanas(data.semanas || []);
            construirResumenMensual(data.estatus || []);
            construirGraficaEstatus(data.estatus || []);
            construirTabla(data.semanas || []);
        }
        
        function actualizarEstatus(estatus) {
            // Primero ocultamos todas las cards para evitar que
            // queden visibles datos de una consulta anterior.
            document.querySelectorAll('.dashboard-estatus').forEach(card => {
                card.style.display = 'none';
            });
            
            var totalEstatus = 0;
            
            estatus.forEach(item => {
                const id = `total${item.abreviacion}`;
                const elemento = document.getElementById(id);

                if (!elemento)
                    return;

                const total = Number(item.total) || 0;
                
                totalEstatus += total;
                
                elemento.textContent = total;

                const card = elemento.closest('.dashboard-estatus');

                if (card) {
                    card.style.display = total > 0 ? '' : 'none';
                }
            });
            document.getElementById('totalContinuidades').textContent = totalEstatus;
        }
       
       function actualizarPorcentajesCards(estatus) {

            const visibles = estatus.filter(item => (Number(item.total) || 0) > 0);

            // Si la API devuelve una métrica "Ingresadas", se conserva como base.
            // Cuando no existe (como en En Curso, En Movimientos, Pendiente de Pago,
            // Pagada, Concluida, Cancelada, Improcedente), la base es la suma de
            // todos los estatus visibles del periodo.
            const ingresadas = visibles.find(item => {
                const nombre = (item.nombre || '').toLowerCase();
                const abrev = (item.abreviacion || '').toUpperCase();
                return abrev === 'ING' || nombre.includes('ingres');
            });

            const sumaEstatus = visibles.reduce(
                (acumulado, item) => acumulado + (Number(item.total) || 0),
                0
            );

            const totalBase = Number(ingresadas?.total) || sumaEstatus;

            estatus.forEach(item => {
                const total = Number(item.total) || 0;
                const etiqueta = document.getElementById(`porcentaje${item.abreviacion}`);

                if (!etiqueta)
                    return;

                // "Ingresadas" representa la base completa cuando viene en la respuesta.
                if (ingresadas && item.abreviacion === ingresadas.abreviacion) {
                    etiqueta.textContent = '100.0% del total';
                    return;
                }

                const porcentaje = totalBase > 0 ? (total / totalBase) * 100 : 0;
                etiqueta.textContent = `${porcentaje.toFixed(1)}% del total`;
            });
        }

        function construirTarjetasSemanas(semanas) {

            const contenedor = document.getElementById('contenedorSemanas');
            contenedor.innerHTML = '';

            semanas.forEach(semana => {

                const operativo = Number(semana.ingresadasOperativo) || 0;
                const mandoMedio = Number(semana.ingresadasMandoMedio) || 0;
                const mandoSuperior = Number(semana.ingresadasMandoSuperior) || 0;
                const total = operativo + mandoMedio + mandoSuperior;

                if (total <= 0)
                    return;

                const porcentajeOP = (operativo / total) * 100;
                const porcentajeMM = (mandoMedio / total) * 100;
                const porcentajeMS = (mandoSuperior / total) * 100;

                let detalle = '';

                if (operativo > 0) {
                    detalle += `
                        <div class="personal-row">
                            <div class="personal-info">
                                <span>Operativo</span>
                                <strong>${operativo.toLocaleString('es-MX')} ${operativo === 1 ? 'continuidad' : 'continuidades'} <span class="text-muted">(${porcentajeOP.toFixed(1)}%)</span></strong>
                            </div>
                            <div class="progress-dashboard">
                                <div class="dashboard-fill barra-op"
                                     style="width:${porcentajeOP}%; background:#007bff !important;"
                                     title="Operativo: ${operativo} (${porcentajeOP.toFixed(1)}%)"></div>
                            </div>
                        </div>`;
                }

                if (mandoMedio > 0) {
                    detalle += `
                        <div class="personal-row">
                            <div class="personal-info">
                                <span>Mando medio</span>
                                <strong>${mandoMedio.toLocaleString('es-MX')} ${mandoMedio === 1 ? 'continuidad' : 'continuidades'} <span class="text-muted">(${porcentajeMM.toFixed(1)}%)</span></strong>
                            </div>
                            <div class="progress-dashboard">
                                <div class="dashboard-fill barra-mm"
                                     style="width:${porcentajeMM}%; background:#28a745 !important;"
                                     title="Mando medio: ${mandoMedio} (${porcentajeMM.toFixed(1)}%)"></div>
                            </div>
                        </div>`;
                }

                if (mandoSuperior > 0) {
                    detalle += `
                        <div class="personal-row">
                            <div class="personal-info">
                                <span>Mando superior</span>
                                <strong>${mandoSuperior.toLocaleString('es-MX')} ${mandoSuperior === 1 ? 'continuidad' : 'continuidades'} <span class="text-muted">(${porcentajeMS.toFixed(1)}%)</span></strong>
                            </div>
                            <div class="progress-dashboard">
                                <div class="dashboard-fill barra-ms"
                                     style="width:${porcentajeMS}%; background:#17a2b8 !important;"
                                     title="Mando superior: ${mandoSuperior} (${porcentajeMS.toFixed(1)}%)"></div>
                            </div>
                        </div>`;
                }

                contenedor.insertAdjacentHTML('beforeend', `
                    <div class="col-lg-4 col-md-6">
                        <div class="semana-card">
                            <div class="semana-header">
                                <div>
                                    <div class="semana-titulo">Semana ${semana.numero}</div>
                                    <div class="semana-periodo">${semana.descripcion || ''}</div>
                                </div>
                                <div class="semana-total">${total.toLocaleString('es-MX')}</div>
                            </div>
                            ${detalle}
                        </div>
                    </div>`);
            });
        }

        function construirResumenMensual(estatus) {

            const contenedor = document.getElementById('resumenMensualEstatus');
            contenedor.innerHTML = '';

            const validos = estatus.filter(e => (Number(e.total) || 0) > 0);
            const maximo = validos.length > 0
                ? Math.max(...validos.map(e => Number(e.total) || 0))
                : 0;

            // La referencia porcentual del mes es Ingresadas cuando dicha métrica
            // viene en la respuesta. Si no existe, se usa la suma de los estatus
            // visibles para que el porcentaje siga siendo representativo.
            const ingresadas = validos.find(e => {
                const nombre = (e.nombre || '').toLowerCase();
                const abrev = (e.abreviacion || '').toUpperCase();
                return abrev === 'ING' || nombre.includes('ingres');
            });

            const sumaEstatus = validos.reduce(
                (acumulado, e) => acumulado + (Number(e.total) || 0),
                0
            );

            const totalBase = Number(ingresadas?.total) || sumaEstatus || 0;

            validos.forEach(item => {

                const total = Number(item.total) || 0;
                const op = Number(item.operativo) || 0;
                const mm = Number(item.mandoMedio) || 0;
                const ms = Number(item.mandoSuperior) || 0;

                const ancho = maximo > 0 ? (total / maximo) * 100 : 0;
                const porcentajeEstatus = totalBase > 0 ? (total / totalBase) * 100 : 0;

                const porcentajeOP = total > 0 ? (op / total) * 100 : 0;
                const porcentajeMM = total > 0 ? (mm / total) * 100 : 0;
                const porcentajeMS = total > 0 ? (ms / total) * 100 : 0;

                const desglose = [];

                if (op > 0)
                    desglose.push(`Operativo ${op.toLocaleString('es-MX')} ${op === 1 ? 'continuidad' : 'continuidades'} (${porcentajeOP.toFixed(1)}%)`);
                if (mm > 0)
                    desglose.push(`Mando medio ${mm.toLocaleString('es-MX')} ${mm === 1 ? 'continuidad' : 'continuidades'} (${porcentajeMM.toFixed(1)}%)`);
                if (ms > 0)
                    desglose.push(`Mando superior ${ms.toLocaleString('es-MX')} ${ms === 1 ? 'continuidad' : 'continuidades'} (${porcentajeMS.toFixed(1)}%)`);

                const nombreEstatus = (item.nombre || '').toLowerCase();
                const abreviacion = (item.abreviacion || '').toUpperCase();

                let claseColor = 'barra-estatus-default';
                let color = '#6c757d';

                if (abreviacion === 'ING' || nombreEstatus.includes('ingres')) {
                    claseColor = 'barra-ing';
                    color = '#007bff';
                }
                else if (abreviacion === 'PAG' || nombreEstatus.includes('pagad')) {
                    claseColor = 'barra-pag';
                    color = '#28a745';
                }
                else if (abreviacion === 'CAN' || nombreEstatus.includes('cancel')) {
                    claseColor = 'barra-can';
                    color = '#dc3545';
                }
                else if (abreviacion === 'IMP' || nombreEstatus.includes('improced')) {
                    claseColor = 'barra-imp';
                    color = '#ffc107';
                }
                else if (abreviacion === 'COR' || nombreEstatus.includes('correcci')) {
                    claseColor = 'barra-cor';
                    color = '#17a2b8';
                }

                contenedor.insertAdjacentHTML('beforeend', `
                    <div class="estatus-resumen">
                        <div class="estatus-resumen-header">
                            <strong>${item.nombre}</strong>
                            <span class="estatus-resumen-total">
                                ${total.toLocaleString('es-MX')} ${total === 1 ? 'continuidad' : 'continuidades'}
                                <span class="text-muted ml-1">(${porcentajeEstatus.toFixed(1)}%)</span>
                            </span>
                        </div>
                        <div class="progress-dashboard">
                            <div class="dashboard-fill ${claseColor}"
                                 style="width:${ancho}%; background:${color} !important;"
                                 title="${item.nombre}: ${total} (${porcentajeEstatus.toFixed(1)}%)"></div>
                        </div>
                        <div class="estatus-desglose">${desglose.join(' · ')}</div>
                    </div>`);
            });
        }

        function construirGraficaSemanas(semanas) {

            const labels =
                semanas.map(
                    s => `Semana ${s.numero}`
                );

            const operativo =
                semanas.map(
                    s =>
                        Number(
                            s.ingresadasOperativo
                        ) || 0
                );

            const mandoMedio =
                semanas.map(
                    s =>
                        Number(
                            s.ingresadasMandoMedio
                        ) || 0
                );

            const mandoSuperior =
                semanas.map(
                    s =>
                        Number(
                            s.ingresadasMandoSuperior
                        ) || 0
                );

            const totalesSemana =
                semanas.map(
                    (_, index) =>
                        operativo[index] +
                        mandoMedio[index] +
                        mandoSuperior[index]
                );

            function calcularPorcentajes(datos) {

                return datos.map(
                    (valor, index) => {

                        const total =
                            totalesSemana[index];

                        if (total === 0)
                            return 0;

                        return (valor / total) * 100;
                    }
                );
            }

            const datasets = [];

            if (operativo.some(v => v > 0)) {

                datasets.push({
                    label: 'Operativo',
                    data: operativo,
                    porcentajes:
                        calcularPorcentajes(
                            operativo
                        ),
                    backgroundColor: '#007bff'
                });
            }

            if (mandoMedio.some(v => v > 0)) {

                datasets.push({
                    label: 'Mando Medio',
                    data: mandoMedio,
                    porcentajes:
                        calcularPorcentajes(
                            mandoMedio
                        ),
                    backgroundColor: '#6f42c1'
                });
            }

            if (mandoSuperior.some(v => v > 0)) {

                datasets.push({
                    label: 'Mando Superior',
                    data: mandoSuperior,
                    porcentajes:
                        calcularPorcentajes(
                            mandoSuperior
                        ),
                    backgroundColor: '#17a2b8'
                });
            }

            if (chartSemanas)
                chartSemanas.destroy();

            const ctx =
                document
                    .getElementById(
                        'chartSemanas'
                    )
                    .getContext('2d');

            chartSemanas =
                new Chart(ctx, {

                    type: 'bar',

                    data: {
                        labels: labels,
                        datasets: datasets
                    },

                    options: {

                        responsive: true,
                        maintainAspectRatio: false,

                        porcentajeLabels: {
                            enabled: true
                        },

                        layout: {
                            padding: {
                                top: 25
                            }
                        },

                        legend: {
                            display:
                                datasets.length > 0
                        },

                        tooltips: {
                            callbacks: {

                                label: function (
                                    tooltipItem,
                                    data) {

                                    const dataset =
                                        data.datasets[
                                            tooltipItem.datasetIndex
                                        ];

                                    const valor =
                                        Number(
                                            dataset.data[
                                                tooltipItem.index
                                            ]
                                        ) || 0;

                                    const porcentaje =
                                        dataset.porcentajes[
                                            tooltipItem.index
                                        ] || 0;

                                    return `${dataset.label}: ${valor} (${porcentaje.toFixed(1)}%)`;
                                }
                            }
                        },

                        scales: {

                            yAxes: [{
                                ticks: {
                                    beginAtZero: true,
                                    precision: 0
                                }
                            }],

                            xAxes: [{
                                gridLines: {
                                    display: false
                                }
                            }]
                        }
                    }
                });
        }

        function construirGraficaEstatus(estatus) {

            // Omite cualquier estatus con total 0.
            const datosValidos =
                estatus.filter(
                    e =>
                        (Number(e.total) || 0) > 0
                );

            const labels =
                datosValidos.map(
                    e => e.nombre
                );

            const datos =
                datosValidos.map(
                    e => Number(e.total) || 0
                );

            const colores =
                datosValidos.map(
                    e =>
                        e.fondoHexadecimal ||
                        '#6c757d'
                );

            if (chartEstatus)
                chartEstatus.destroy();

            const ctx =
                document
                    .getElementById(
                        'chartEstatus'
                    )
                    .getContext('2d');

            chartEstatus =
                new Chart(ctx, {

                    type: 'doughnut',

                    data: {

                        labels: labels,

                        datasets: [{
                            data: datos,
                            backgroundColor: colores,
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },

                    options: {

                        responsive: true,
                        maintainAspectRatio: false,

                        porcentajeLabels: {
                            enabled: true
                        },

                        legend: {
                            position: 'right',
                            display: datosValidos.length > 0,
                            labels: {
                                boxWidth: 11,
                                padding: 10,
                                fontSize: 10,
                                generateLabels: function (chart) {
                                    const ds = chart.data.datasets[0];
                                    const total = ds.data.reduce(
                                        (acumulado, valor) => acumulado + (Number(valor) || 0),
                                        0
                                    );

                                    return chart.data.labels.map(function (label, index) {
                                        const valor = Number(ds.data[index]) || 0;
                                        const porcentaje = total > 0 ? (valor / total) * 100 : 0;
                                        return {
                                            text: `${label}: ${valor.toLocaleString('es-MX')} (${porcentaje.toFixed(1)}%)`,
                                            fillStyle: ds.backgroundColor[index],
                                            strokeStyle: '#ffffff',
                                            lineWidth: 1,
                                            hidden: false,
                                            index: index
                                        };
                                    });
                                }
                            }
                        },

                        tooltips: {
                            callbacks: {

                                label: function (
                                    tooltipItem,
                                    data) {

                                    const dataset =
                                        data.datasets[
                                            tooltipItem.datasetIndex
                                        ];

                                    const valor =
                                        Number(
                                            dataset.data[
                                                tooltipItem.index
                                            ]
                                        ) || 0;

                                    const total =
                                        dataset.data.reduce(
                                            (acumulado, item) =>
                                                acumulado +
                                                Number(item || 0),
                                            0
                                        );

                                    const porcentaje =
                                        total > 0
                                            ? (valor / total) * 100
                                            : 0;

                                    return `${data.labels[tooltipItem.index]}: ${valor} (${porcentaje.toFixed(1)}%)`;
                                }
                            }
                        }
                    }
                });
        }

        function construirComparativo(estatus) {

            // Omite estatus cuyo total OP + MM + MS sea 0.
            const estatusValidos =
                estatus.filter(e => {

                    const operativo =
                        Number(e.operativo) || 0;

                    const mandoMedio =
                        Number(e.mandoMedio) || 0;

                    const mandoSuperior =
                        Number(e.mandoSuperior) || 0;

                    return (
                        operativo +
                        mandoMedio +
                        mandoSuperior
                    ) > 0;
                });

            const labels =
                estatusValidos.map(
                    e => e.nombre
                );

            const operativo =
                estatusValidos.map(
                    e =>
                        Number(
                            e.operativo
                        ) || 0
                );

            const mandoMedio =
                estatusValidos.map(
                    e =>
                        Number(
                            e.mandoMedio
                        ) || 0
                );

            const mandoSuperior =
                estatusValidos.map(
                    e =>
                        Number(
                            e.mandoSuperior
                        ) || 0
                );

            const totales =
                estatusValidos.map(
                    (_, index) =>
                        operativo[index] +
                        mandoMedio[index] +
                        mandoSuperior[index]
                );

            function obtenerPorcentajes(datos) {

                return datos.map(
                    (valor, index) => {

                        if (totales[index] === 0)
                            return 0;

                        return (
                            valor /
                            totales[index]
                        ) * 100;
                    }
                );
            }

            const datasets = [];

            if (operativo.some(v => v > 0)) {

                datasets.push({
                    label: 'Operativo',
                    data: operativo,
                    porcentajes:
                        obtenerPorcentajes(
                            operativo
                        ),
                    backgroundColor: '#007bff'
                });
            }

            if (mandoMedio.some(v => v > 0)) {

                datasets.push({
                    label: 'Mando Medio',
                    data: mandoMedio,
                    porcentajes:
                        obtenerPorcentajes(
                            mandoMedio
                        ),
                    backgroundColor: '#6f42c1'
                });
            }

            if (mandoSuperior.some(v => v > 0)) {

                datasets.push({
                    label: 'Mando Superior',
                    data: mandoSuperior,
                    porcentajes:
                        obtenerPorcentajes(
                            mandoSuperior
                        ),
                    backgroundColor: '#17a2b8'
                });
            }

            if (chartComparativo)
                chartComparativo.destroy();

            const ctx =
                document
                    .getElementById(
                        'chartComparativo'
                    )
                    .getContext('2d');

            chartComparativo =
                new Chart(ctx, {

                    type: 'bar',

                    data: {
                        labels: labels,
                        datasets: datasets
                    },

                    options: {

                        responsive: true,
                        maintainAspectRatio: false,

                        porcentajeLabels: {
                            enabled: true
                        },


                        layout: {
                            padding: {
                                top: 25
                            }
                        },

                        legend: {
                            display:
                                datasets.length > 0
                        },

                        tooltips: {
                            callbacks: {

                                label: function (
                                    tooltipItem,
                                    data) {

                                    const dataset =
                                        data.datasets[
                                            tooltipItem.datasetIndex
                                        ];

                                    const valor =
                                        Number(
                                            dataset.data[
                                                tooltipItem.index
                                            ]
                                        ) || 0;

                                    const porcentaje =
                                        dataset.porcentajes[
                                            tooltipItem.index
                                        ] || 0;

                                    return `${dataset.label}: ${valor} (${porcentaje.toFixed(1)}%)`;
                                }
                            }
                        },

                        scales: {

                            yAxes: [{
                                ticks: {
                                    beginAtZero: true,
                                    precision: 0
                                }
                            }],

                            xAxes: [{
                                gridLines: {
                                    display: false
                                }
                            }]
                        }
                    }
                });
        }

        function construirTabla(semanas) {

            const thead =
                document.getElementById(
                    'tablaSemanasHead'
                );

            const tbody =
                document.getElementById(
                    'tablaSemanas'
                );

            const tfoot =
                document.getElementById(
                    'tablaSemanasFoot'
                );

            thead.innerHTML = '';
            tbody.innerHTML = '';
            tfoot.innerHTML = '';

            const totalOperativo =
                semanas.reduce(
                    (total, semana) =>
                        total +
                        (Number(
                            semana.ingresadasOperativo
                        ) || 0),
                    0
                );

            const totalMandoMedio =
                semanas.reduce(
                    (total, semana) =>
                        total +
                        (Number(
                            semana.ingresadasMandoMedio
                        ) || 0),
                    0
                );

            const totalMandoSuperior =
                semanas.reduce(
                    (total, semana) =>
                        total +
                        (Number(
                            semana.ingresadasMandoSuperior
                        ) || 0),
                    0
                );

            const totalGeneral =
                totalOperativo +
                totalMandoMedio +
                totalMandoSuperior;

            // Las columnas sólo se muestran si tienen algún valor.
            const mostrarOperativo =
                totalOperativo > 0;

            const mostrarMandoMedio =
                totalMandoMedio > 0;

            const mostrarMandoSuperior =
                totalMandoSuperior > 0;

            let encabezado = `
                <tr>
                    <th>Semana</th>
                    <th>Periodo</th>
            `;

            if (mostrarOperativo) {
                encabezado += `
                    <th class="text-center">
                        Operativo
                    </th>`;
            }

            if (mostrarMandoMedio) {
                encabezado += `
                    <th class="text-center">
                        Mando Medio
                    </th>`;
            }

            if (mostrarMandoSuperior) {
                encabezado += `
                    <th class="text-center">
                        Mando Superior
                    </th>`;
            }

            encabezado += `
                    <th class="text-center">
                        Total
                    </th>
                </tr>
            `;

            thead.innerHTML =
                encabezado;

            semanas.forEach(
                semana => {

                    const operativo =
                        Number(
                            semana.ingresadasOperativo
                        ) || 0;

                    const mandoMedio =
                        Number(
                            semana.ingresadasMandoMedio
                        ) || 0;

                    const mandoSuperior =
                        Number(
                            semana.ingresadasMandoSuperior
                        ) || 0;

                    const totalSemana =
                        operativo +
                        mandoMedio +
                        mandoSuperior;

                    const tr =
                        document.createElement('tr');

                    let html = `
                        <td>
                            <strong>
                                Semana ${semana.numero}
                            </strong>
                        </td>

                        <td>
                            ${semana.descripcion}
                        </td>
                    `;

                    if (mostrarOperativo) {
                        html += `
                            <td class="text-center">
                                ${operativo}
                            </td>`;
                    }

                    if (mostrarMandoMedio) {
                        html += `
                            <td class="text-center">
                                ${mandoMedio}
                            </td>`;
                    }

                    if (mostrarMandoSuperior) {
                        html += `
                            <td class="text-center">
                                ${mandoSuperior}
                            </td>`;
                    }

                    html += `
                        <td class="text-center">
                            <strong>
                                ${totalSemana}
                            </strong>
                        </td>
                    `;

                    tr.innerHTML = html;
                    tbody.appendChild(tr);
                });

            let footer = `
                <tr class="bg-light">
                    <th colspan="2">
                        TOTAL DEL PERIODO
                    </th>
            `;

            if (mostrarOperativo) {
                footer += `
                    <th class="text-center">
                        ${totalOperativo}
                    </th>`;
            }

            if (mostrarMandoMedio) {
                footer += `
                    <th class="text-center">
                        ${totalMandoMedio}
                    </th>`;
            }

            if (mostrarMandoSuperior) {
                footer += `
                    <th class="text-center">
                        ${totalMandoSuperior}
                    </th>`;
            }

            footer += `
                    <th class="text-center">
                        ${totalGeneral}
                    </th>
                </tr>
            `;

            tfoot.innerHTML =
                footer;
        }
    </script>
}
