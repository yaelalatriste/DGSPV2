                                })
                            }
                        });
                    }
                });
            });
            
            $("#fechaInicio, #fechaFinal").on("change", function () {
                cargarQuincenas();
            });
            
            function cargarQuincenas() {
                const fechaInicio = $("#fechaInicio").val();
                const fechaFinal = $("#fechaFinal").val();
                const selectQuincenas = $("#quincenas");

                /*
                 * Guardamos el valor seleccionado antes de limpiar el select.
                 *
                 * Primero intentamos recuperar el valor actual del control.
                 * Si no tiene valor, usamos el que viene desde el modelo.
                 */
                const valorActual = selectQuincenas.val();
                const valorModelo = parseInt("@Model.FiltrosPoliza.Quincenas") || "";
                const valorSeleccionado = valorActual || valorModelo;

                /*
                * Limpiamos las opciones actuales.
                */
                selectQuincenas.empty();

                selectQuincenas.append('<option value="">Seleccione la quincena</option>');

                /*
                 * No consultar hasta que ambas fechas tengan información.
                 */
                if (!fechaInicio || !fechaFinal) {
                    selectQuincenas.prop("disabled", true);
                    return;
                }

                /*
                 * Validar que la fecha final no sea menor
                 * que la fecha inicial.
                 */
               

                /*
                 * Deshabilitar mientras se realiza la consulta.
                 */
                selectQuincenas.prop("disabled", true);
                axios.get('@Url.Page(null, "Quincenas")', {
                    params: {
                        fechaInicio: fechaInicio,
                        fechaFinal: fechaFinal
                    }
                }).then(function (response) {
                    const quincenas = response.data || [];
                    quincenas.forEach(function (quincena) {
                        selectQuincenas.append(
                            $("<option>", {
                                value: quincena.quincenaRestante,
                                text: quincena.quincenaRestante + " Quincena(s)"
                            })
                        );
                    });

                    /*
                     * Verificamos que el valor utilizado anteriormente
                     * siga existiendo entre las nuevas opciones.
                     */
                    const existeValorSeleccionado = selectQuincenas.find('option[value="' + valorSeleccionado + '"]').length > 0;
                    /*
                    * Si existe, volvemos a seleccionarlo.
                    */
                    if (existeValorSeleccionado) {
                        selectQuincenas.val(String(valorSeleccionado));
                    }
                    else {
                        selectQuincenas.val("");
                    }
                    selectQuincenas.prop("disabled",quincenas.length === 0);
                })
                .catch(function (error) {
                    console.error("Error al consultar las quincenas:",error);
                    selectQuincenas.prop("disabled", true);
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "No fue posible consultar las quincenas del periodo."
                    });
                });
            }
        });
    </script>
}