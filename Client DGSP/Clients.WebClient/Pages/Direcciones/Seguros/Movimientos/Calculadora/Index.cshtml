                                <div class="col-lg-2">
                                    <label>Periodo: </label> @Model.FiltrosPoliza.FechaInicio.ToString("dd/MM/yyyy") al @Model.FiltrosPoliza.FechaFinal.ToString("dd/MM/yyyy")
                                </div>
                                <div class="col-lg-2">
                                    <label>IQ: </label> @Model.Catalogos.IQ.Where(tp => tp.Id == Model.FiltrosPoliza.IQ).First().Descripcion
                                </div>
                                <div class="col-lg-2">
                                    <label>Quincenas: </label> @Model.FiltrosPoliza.Quincenas
                                </div>
                            </div>
                        </div>
                    }
